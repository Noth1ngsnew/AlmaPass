# Скопируйте в .env и подставьте свои значения
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-32-chars-or-more
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=almapass
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- NFT (тестовая сеть Polygon Amoy) ---
NFT_RPC_URL=https://rpc-amoy.polygon.technology
NFT_CHAIN_ID=80002
NFT_EXPLORER_URL=https://amoy.polygonscan.com
# Ключ серверного кошелька: python manage.py create_nft_wallet
NFT_PRIVATE_KEY=
# Адрес контракта: python manage.py deploy_nft_contract
NFT_CONTRACT_ADDRESS=
